<h3>Nivel 4: Codigo Relevante</h3>
<div class="code">@CircuitBreaker(
    requestVolumeThreshold = 4,
    failureRatio = 0.5,
    delay = 5000
)
@Fallback(fallbackMethod = "fallbackProducto")
@Timeout(3000)
public ProductoDTO obtenerProducto(Long id) {
    return productoClient.buscarProductoPorId(id);
}</div>

<h2>11. Microservicios Implementados</h2>
<table>
  <tr><th>Microservicio</th><th>Responsabilidad</th><th>Puerto</th></tr>
  <tr><td>api-gateway</td><td>Entrada centralizada</td><td>8030</td></tr>
  <tr><td>ms-auth</td><td>Login, JWT, usuarios y roles</td><td>8084</td></tr>
  <tr><td>ms-cliente</td><td>Gestion y validacion de clientes</td><td>8082</td></tr>
  <tr><td>ms-producto</td><td>Productos y stock</td><td>8080</td></tr>
  <tr><td>ms-producto-2</td><td>Segunda instancia de productos</td><td>8085</td></tr>
  <tr><td>ms-ventas</td><td>Ventas, Saga y auditoria</td><td>8083</td></tr>
  <tr><td>Consul</td><td>Registro y descubrimiento</td><td>8500</td></tr>
</table>

<h2>12. API REST Documentada</h2>
<table>
  <tr><th>Modulo</th><th>Metodo</th><th>Ruta</th><th>Descripcion</th></tr>
  <tr><td>Auth</td><td>POST</td><td>/api/auth/login</td><td>Login y generacion de JWT</td></tr>
  <tr><td>Clientes</td><td>GET</td><td>/api/clientes</td><td>Listar clientes</td></tr>
  <tr><td>Clientes</td><td>PUT</td><td>/api/clientes/{id}</td><td>Actualizar cliente</td></tr>
  <tr><td>Clientes</td><td>PUT</td><td>/api/clientes/{id}/activar</td><td>Activar cliente</td></tr>
  <tr><td>Clientes</td><td>PUT</td><td>/api/clientes/{id}/desactivar</td><td>Desactivar cliente</td></tr>
  <tr><td>Productos</td><td>POST</td><td>/api/productos</td><td>Crear producto</td></tr>
  <tr><td>Productos</td><td>GET</td><td>/api/productos</td><td>Listar productos</td></tr>
  <tr><td>Productos</td><td>PUT</td><td>/api/productos/{id}</td><td>Actualizar producto</td></tr>
  <tr><td>Productos</td><td>DELETE</td><td>/api/productos/{id}</td><td>Eliminar producto solo si no tiene ventas</td></tr>
  <tr><td>Ventas</td><td>GET</td><td>/api/ventas</td><td>Listar ventas</td></tr>
  <tr><td>Saga</td><td>POST</td><td>/api/ventas/saga</td><td>Ejecutar venta Saga</td></tr>
  <tr><td>Saga</td><td>POST</td><td>/api/ventas/saga/carrito/cliente</td><td>Compra cliente por carrito</td></tr>
  <tr><td>Saga</td><td>GET</td><td>/api/ventas/saga-logs</td><td>Listar auditoria Saga</td></tr>
</table>

